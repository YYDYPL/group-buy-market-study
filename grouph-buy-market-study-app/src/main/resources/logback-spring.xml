<?xml version="1.0" encoding="UTF-8"?>
<!--
    Spring Boot Logback 配置。
    日志级别从低到高为 TRACE < DEBUG < INFO < WARN < ERROR；阈值设为 WARN 时会过滤更低级别。
    scan=true 表示运行期间每 10 秒检查配置变化并尝试重新加载。
-->
<configuration scan="true" scanPeriod="10 seconds">

    <!-- 上下文名称用于区分同一日志系统中的不同应用。 -->
    <contextName>logback</contextName>
    <!-- 从 Spring Environment 读取 logging.path，后续可用 ${log.path} 引用。 -->
    <springProperty scope="context" name="log.path" source="logging.path"/>
    <!-- 注册 Spring Boot 提供的颜色和异常格式转换器。 -->
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex"
                    converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx"
                    converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <!-- 控制台输出：仅输出 INFO 及以上日志，适合本地开发和容器标准输出采集。 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <!-- ThresholdFilter 过滤低于 INFO 的事件。 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>info</level>
        </filter>
        <encoder>
            <!-- 输出时间、线程、级别、Logger、服务标识、TraceId 和正文。 -->
            <pattern>%d{yy-MM-dd.HH:mm:ss.SSS} [%-16t] %-5p %-22c{0}%X{ServiceId} -%X{trace-id} %m%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- INFO 文件：当前根 Logger 的所有 INFO 及以上事件都会进入该文件。 -->
    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当天正在写入的活动日志文件。 -->
        <file>./data/log/log_info.log</file>
        <!-- 文件编码和输出字段与控制台保持一致，便于交叉检索。 -->
        <encoder>
            <pattern>%d{yy-MM-dd.HH:mm:ss.SSS} [%-16t] %-5p %-22c{0}%X{ServiceId} -%X{trace-id} %m%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- 同时按日期和单文件大小滚动，避免单个日志文件过大。 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- %d 按天分组，%i 是同一天内超过 100MB 后递增的文件序号。 -->
            <fileNamePattern>./data/log/log-info-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <!-- 最多保留 15 天且所有归档总量不超过 10GB，任一条件达到都会清理旧文件。 -->
            <maxHistory>15</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ERROR_FILE 实际接收 WARN 及以上事件，用于快速定位告警和异常。 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 正在记录的日志文件的路径及文件名 -->
        <file>./data/log/log_error.log</file>
        <!--日志文件输出格式-->
        <encoder>
            <pattern>%d{yy-MM-dd.HH:mm:ss.SSS} [%-16t] %-5p %-22c{0}%X{ServiceId} -%X{trace-id} %m%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- 日志记录器的滚动策略，按日期，按大小记录 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>./data/log/log-error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <!-- 错误归档最多保留 7 天、总量不超过 5GB。 -->
            <maxHistory>7</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <!-- WARN 级别及以上才写入该文件。 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>

    <!-- INFO 文件异步包装器：将磁盘 IO 从业务线程转移到 Logback 工作线程。 -->
    <appender name="ASYNC_FILE_INFO" class="ch.qos.logback.classic.AsyncAppender">
        <!-- discardingThreshold=0 禁止按剩余容量主动丢弃低级别日志。 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 较大队列用于吸收短时日志峰值，但也会增加内存占用。 -->
        <queueSize>8192</queueSize>
        <!-- 队列完全写满时不阻塞业务线程，代价是可能丢失日志。 -->
        <neverBlock>true</neverBlock>
        <!-- 不提取调用代码位置，减少异步日志的栈遍历开销。 -->
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="INFO_FILE"/>
    </appender>

    <!-- WARN/ERROR 文件使用独立异步队列，避免普通信息日志挤占错误日志容量。 -->
    <appender name="ASYNC_FILE_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 队列剩余容量小于discardingThreshold,则会丢弃TRACT、DEBUG、INFO级别的日志;默认值-1,为queueSize的20%;0不丢失日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 更改默认的队列的深度,该值会影响性能.默认值为256 -->
        <queueSize>1024</queueSize>
        <!-- neverBlock:true 会丢失日志,但业务性能不受影响 -->
        <neverBlock>true</neverBlock>
        <!--是否提取调用者数据-->
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <springProfile name="prod">
        <!-- 从 Spring 配置读取 Logstash 主机；缺失时回退到本机。 -->
        <springProperty name="LOG_STASH_HOST" scope="context" source="logstash.host" defaultValue="127.0.0.1"/>

        <!-- 将结构化 JSON 日志通过 TCP 4560 端口发送给 Logstash。 -->
        <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <!-- 目标端口需要与 Logstash input 插件监听端口保持一致。 -->
            <destination>${LOG_STASH_HOST}:4560</destination>
            <encoder charset="UTF-8" class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
    </springProfile>

    <!-- 仅 dev profile 生效的包级 DEBUG Logger。 -->
    <springProfile name="dev">
        <logger name="com.nmys.view" level="debug"/>
    </springProfile>

    <!-- 本地和测试环境不连接未部署的 Logstash。 -->
    <springProfile name="dev,test">
        <root level="info">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE_INFO"/>
            <appender-ref ref="ASYNC_FILE_ERROR"/>
        </root>
    </springProfile>

    <!-- 生产环境保留结构化日志上报。 -->
    <springProfile name="prod">
        <root level="info">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE_INFO"/>
            <appender-ref ref="ASYNC_FILE_ERROR"/>
            <appender-ref ref="LOGSTASH"/>
        </root>
    </springProfile>

    <!-- 未指定 Spring profile 时仍输出本地日志。 -->
    <springProfile name="!dev &amp; !test &amp; !prod">
        <root level="info">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE_INFO"/>
        <appender-ref ref="ASYNC_FILE_ERROR"/>
        </root>
    </springProfile>

</configuration>
